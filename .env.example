# Skopiuj do .env i uzupełnij własnymi kluczami.

# Wymagane (dostawca modelu: OpenAI)
OPENAI_API_KEY=sk-...

# Opcjonalne: nadpisanie domyślnego modelu (format LangChain "provider:model").
# Domyślnie: openai:gpt-4o-mini (tani). Przykłady droższych/lepszych:
# ORCHESTRATOR_MODEL=openai:gpt-4.1-mini
# ORCHESTRATOR_MODEL=openai:gpt-5.5

# Opcjonalne: folder z dokumentami do RAG (domyślnie ./nordvik-dataset).
# NORDVIK_DOCS_DIR=nordvik-dataset

# Opcjonalne: pamięć grafowa GraphRAG (Neo4j) w pakiecie self_learning_agents.
# Bez tych zmiennych narzędzia grafowe zgłaszają niedostępność, a agent działa
# dalej na plikach. Graf buduje subagent graph-retriever (narzędzie graph_build).
# NEO4J_URI=neo4j+s://<twoja-instancja>.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=...

# Opcjonalne: folder pamięci długoterminowej (self_learning_agents; domyślnie ./agent-memory).
# SLA_MEMORY_DIR=agent-memory
